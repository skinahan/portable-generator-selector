# Optional affiliate identifiers. Leave blank to link to manufacturer pages only
# (no disclosure text is rendered in that case). Set these in the Vercel
# project environment; they are read at build time.

# Amazon Associates tracking ID, e.g. silverrook-20
VITE_AMAZON_ASSOCIATES_TAG=

# Impact deep-link template for The Home Depot. Must contain the literal token
# {url}, which is replaced with the URL-encoded product or search page.
# e.g. https://homedepot.sjv.io/c/<partnerId>/<adId>/8154?u={url}
VITE_HOME_DEPOT_LINK_TEMPLATE=

# Canonical site origin used by the generated guide pages and sitemap.
VITE_SITE_URL=https://portable-generator-selector.vercel.app
